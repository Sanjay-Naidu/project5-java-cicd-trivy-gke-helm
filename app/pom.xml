<?xml version="1.0" encoding="UTF-8"?>
<!--
=============================================================================
Project : Project 5 - Java (Spring Boot) App CI/CD on Google GKE
Author  : Sanjay Naidu
File    : app/pom.xml - Maven build for the ebayshopping service
=============================================================================
WHY Spring Boot 4.x : current generation, Jakarta EE 11, first-class
                      Kubernetes probes via Actuator. Pinned through the
                      parent POM so every dependency version is consistent.
WHY Java 21 (LTS)   : long-term support, virtual threads, supported by every
                      tool in the pipeline (JaCoCo, Sonar, distroless base).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.sanjaynaidu</groupId>
    <artifactId>ebayshopping</artifactId>
    <version>1.0.0</version>
    <name>ebayshopping</name>
    <description>ebayshopping - demo e-commerce storefront deployed to GKE</description>

    <properties>
        <java.version>21</java.version>
        <jacoco.version>0.8.15</jacoco.version>
        <!-- SECURITY OVERRIDE: Boot 4.1.1 manages Tomcat 11.0.24, which the
             Trivy gate blocked on first run (CVE-2026-65182, CVE-2026-65905,
             CVE-2026-68525 - all CRITICAL, fixed in 11.0.25). Boot exposes the
             version as a property exactly for this. Remove the override once
             a Boot patch release manages >= 11.0.25 (Dependabot will PR it). -->
        <tomcat.version>11.0.26</tomcat.version>
        <!-- SonarCloud settings are passed by the pipeline (-Dsonar.*), this
             only tells the scanner where the coverage report lives. -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <!-- Web: Spring MVC + embedded Tomcat (REST API + server-side pages) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Ops: health probes for Kubernetes + Prometheus metrics endpoint -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Tests: JUnit 5, AssertJ, MockMvc, JsonPath -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Fixed jar name so the Dockerfile never has to guess the version. -->
        <finalName>ebayshopping</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Coverage: report is generated during `mvn verify` and picked
                 up by SonarCloud (when enabled) and the CI job summary. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Quality gate in the build itself: fall below 70% line
                         coverage and `mvn verify` fails - no Sonar needed. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
